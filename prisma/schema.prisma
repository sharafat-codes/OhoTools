// OhoTool — Prisma schema
// Phase 1: Better Auth core models + minimal SaaS-forward fields.
// Phase 2: QRCode + Barcode (saved history).
// Phase 3: Subscription (Stripe billing).
// Later phases add: Folder, ScanLog, ApiKey, Usage, Payment, Workspace,
// TeamMember.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

// ─── Better Auth core models ─────────────────────────────────────────────────
// Field shapes match Better Auth's expected schema. `role` and `plan` are
// OhoTool additions surfaced back through the session (see lib/auth.ts).

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?

  role Role     @default(USER)
  // Denormalized current tier for fast gating; kept in sync by the Stripe webhook.
  plan PlanTier @default(FREE)

  // Opt-in (default) for engagement/marketing email. Transactional email
  // (password reset, verification) ignores this. Toggled via /unsubscribe.
  marketingEmails Boolean @default(true)

  stripeCustomerId String? @unique
  // Lemon Squeezy subscription id, captured from webhooks so the customer
  // portal can be opened without depending on the checkout email matching.
  lemonSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  qrCodes      QRCode[]
  barcodes     Barcode[]
  dynamicLinks DynamicLink[]
  apiKeys      ApiKey[]
  transfers    Transfer[]
  aiUsage        AiUsage[]
  interviewUsage InterviewUsage[]
  favoriteTools  FavoriteTool[]
  cards          Card[]
  subscription   Subscription?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id         String @id
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("verification")
}

// ─── Phase 2: Tools (saved history) ──────────────────────────────────────────
// We persist the content + render options, not image blobs — the image is
// regenerated on demand client-side. File storage (R2/S3) comes later.

model QRCode {
  id   String  @id @default(cuid())
  name String?
  data String  @db.Text // encoded content (URL / text)

  // Customization
  fgColor String @default("#000000")
  bgColor String @default("#ffffff")
  size    Int    @default(512)
  margin  Int    @default(2)
  ecLevel String @default("M") // L | M | Q | H

  // Pro styling
  moduleStyle String  @default("square") // square | rounded | dots
  gradient    Boolean @default(false)
  fgColor2    String? // second gradient stop (used when gradient = true)
  logo        String? @db.Text // base64 data URL, centered

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("qr_code")
}

model Barcode {
  id   String  @id @default(cuid())
  name String?
  data String  @db.Text // encoded content

  // Customization
  format      String  @default("code128") // bwip-js bcid
  scale       Int     @default(3)
  height      Int     @default(60)
  includeText Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("barcode")
}

// ─── Dynamic QR (Pro): editable target + scan analytics ──────────────────────

model DynamicLink {
  id        String  @id @default(cuid())
  shortCode String  @unique
  name      String?
  targetUrl String  @db.Text
  active    Boolean @default(true)

  // QR appearance (the code encodes /r/<shortCode>)
  fgColor String @default("#000000")
  bgColor String @default("#ffffff")

  scanCount Int       @default(0)
  expiresAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans  ScanLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("dynamic_link")
}

model ScanLog {
  id String @id @default(cuid())

  linkId String
  link   DynamicLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  device    String? // Mobile | Tablet | Desktop
  referrer  String?
  country   String?
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
  @@map("scan_log")
}

// ─── API keys (Pro): programmatic access ─────────────────────────────────────
// Only a SHA-256 hash of the key is stored; the raw key is shown once at creation.

model ApiKey {
  id        String  @id @default(cuid())
  name      String
  hashedKey String  @unique
  prefix    String // display label, e.g. "oho_a1b2c3d4"
  last4     String

  usageCount Int       @default(0)
  lastUsedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("api_key")
}

// Monthly API call counter per user (all their keys combined). `period` is the
// UTC "YYYY-MM" bucket, so usage resets automatically at the start of a month.
model ApiUsage {
  userId String
  period String
  count  Int    @default(0)

  @@id([userId, period])
  @@map("api_usage")
}

// Per-tool daily view counter, powering the admin analytics dashboard.
// `day` is the UTC "YYYY-MM-DD" bucket; rows stay bounded (tools × days).
model ToolView {
  slug  String
  day   String
  count Int    @default(0)

  @@id([slug, day])
  @@map("tool_view")
}

// User-submitted "request a tool" suggestions — the admin roadmap inbox.
model ToolRequest {
  id        String   @id @default(cuid())
  tool      String
  details   String?
  email     String?
  status    String   @default("new") // new | done | dismissed
  createdAt DateTime @default(now())

  @@index([status])
  @@map("tool_request")
}

// ─── Phase 3: Billing ────────────────────────────────────────────────────────
// One active subscription per user. Stripe is the source of truth; this table
// mirrors it (kept in sync by the webhook). User.plan is the fast-read copy.

model Subscription {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId     String @unique
  stripeSubscriptionId String @unique
  stripePriceId        String

  status            String // active | trialing | past_due | canceled | unpaid | incomplete
  plan              PlanTier
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription")
}

// ─── Send: end-to-end encrypted file transfer (share by link) ────────────────
// Files are encrypted in the browser; the server only ever stores ciphertext
// (in object storage) plus these metadata fields. The decryption key lives in
// the share link's URL fragment and is never sent to the server. Rows + objects
// are purged after expiry (max 24h) by a cron job.
model Transfer {
  id          String @id @default(cuid())
  storagePath String @unique

  // Encrypted metadata (filename + MIME type), base64 — needs the link key to read.
  metaCipher String @db.Text
  metaIv     String
  contentIv  String

  size      Int // ciphertext byte length (for UI + quota)
  downloads Int @default(0)

  // Optional password gate. We store only a hash of the client-derived PBKDF2
  // verifier (+ its salt); the raw password is never sent to or stored on the
  // server. The server withholds the signed download URL until the recipient
  // proves knowledge of the password.
  passwordHash String?
  passwordSalt String?

  expiresAt DateTime

  // Optional owner (for "My Files" later); anonymous transfers have none.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, createdAt])
  @@map("transfer")
}

// ─── AI tools: per-user daily usage (freemium quota) ─────────────────────────
// Free (logged-in) users get a small number of AI runs per UTC day; Pro is
// unlimited (never written here). One row per user per day.
model AiUsage {
  id     String @id @default(cuid())
  userId String
  day    String // UTC "YYYY-MM-DD"
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@map("ai_usage")
}

// Daily counter for mock-interview sessions started (one row per user per UTC
// day). Separate from AiUsage because one interview = many AI calls, so it's
// metered per session, not per call.
model InterviewUsage {
  id      String @id @default(cuid())
  userId  String
  day     String // UTC "YYYY-MM-DD"
  count   Int    @default(0) // interview sessions started today
  reports Int    @default(0) // feedback reports generated today

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@map("interview_usage")
}

// A tool a user has saved as a favorite. Anonymous users keep favorites in
// localStorage; on sign-in those merge into these rows for cross-device sync.
model FavoriteTool {
  id        String   @id @default(cuid())
  userId    String
  slug      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
  @@map("favorite_tool")
}

// ─── Saved cards / invitations (accounts) ────────────────────────────────────
// The full CardData is stored as a JSON string in `data` (photo included). Lets
// a signed-in user re-open and edit a card in the dashboard. Sharing still works
// via the self-contained encoded link, independent of this row.
model Card {
  id        String   @id @default(cuid())
  // Nullable: an anonymous creator can mint a tracked card (short link + open
  // notifications) without an account. Owned cards (dashboard) set userId.
  userId    String?
  title     String?
  occasion  String   @default("birthday")
  data      String   @db.Text // JSON.stringify(CardData)

  // Clean public share link + open counter (set on save).
  shortCode    String?   @unique
  views        Int       @default(0)
  lastOpenedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchers CardWatch[]

  @@index([userId, createdAt])
  @@map("card")
}

// Someone who asked to be emailed when a specific card is opened. `notified`
// flips true after the first open so we email once, not on every view.
model CardWatch {
  id        String   @id @default(cuid())
  cardId    String
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, email])
  @@index([cardId])
  @@map("card_watch")
}

// Marketing email list for people without an account (e.g. captured while
// sharing a card). consentMarketing gates any non-transactional send.
model Subscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  source           String?
  consentMarketing Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("subscriber")
}
